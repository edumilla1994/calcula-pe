# Copia este archivo como .env y completa los valores.
# .env está en .gitignore: nunca se sube al repositorio.

# Google Analytics 4 — Administrar > Flujos de datos > tu flujo web
PUBLIC_GA_ID=G-XXXXXXXXXX

# Search Console — verificación por etiqueta HTML (solo el valor de content)
PUBLIC_GSC_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google AdSense — cuando la cuenta esté aprobada
PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_SLOT=XXXXXXXXXX
