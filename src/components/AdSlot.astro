---
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const slot = import.meta.env.PUBLIC_ADSENSE_SLOT;
const activo = Boolean(client && slot);
const demo = import.meta.env.DEV && !activo;
---

{(activo || demo) && (
  <div class="container">
    <div class:list={['ad-slot', demo && 'ad-slot-demo']} aria-label="Espacio publicitario">
      <span class="ad-label">Publicidad</span>
      {activo ? (
        <>
          <ins
            class="adsbygoogle"
            style="display:block"
            data-ad-client={client}
            data-ad-slot={slot}
            data-ad-format="auto"
            data-full-width-responsive="true"
          ></ins>
          <script is:inline>
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          </script>
        </>
      ) : (
        <span class="ad-demo-text">Espacio reservado 970 × 90 · se activa con AdSense</span>
      )}
    </div>
  </div>
)}
