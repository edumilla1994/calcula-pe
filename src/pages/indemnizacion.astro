---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const url = (p = '') => base + p.replace(/^\//, '');

const faq = [
  { q: '¿Cuánto me corresponde por despido arbitrario?', a: 'En un contrato indeterminado, 1.5 sueldos por cada año completo o fracción, con un tope de 12 sueldos.' },
  { q: '¿Se cuentan los meses y días?', a: 'Sí. La fracción de año se calcula sumando meses/12 y días/360 para obtener los años proporcionales.' },
  { q: '¿Esto reemplaza a un abogado?', a: 'No. Es un cálculo referencial. Para una demanda o negociación, consulta con un abogado laboral.' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de indemnización por despido Perú',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PEN' },
  inLanguage: 'es-PE',
};
---
<Base
  title="Calculadora de indemnización por despido 2026 Perú"
  description="Calcula la indemnización por despido arbitrario en Perú: 1.5 sueldos por año trabajado, con tope de 12 sueldos. Resultado referencial al instante."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <div class="container tool">
    <section class="panel">
      <h1>Calculadora de indemnización por despido</h1>
      <p class="sub">Para despido arbitrario en contrato indeterminado. Ingresa tu sueldo y el tiempo trabajado.</p>
      <form id="ind-form">
        <label for="sueldo">Sueldo bruto mensual (S/)</label>
        <input id="sueldo" type="number" min="0" step="0.01" value="1500" required />

        <label for="anios">Años completos trabajados</label>
        <input id="anios" type="number" min="0" step="1" value="1" required />

        <label for="meses">Meses adicionales</label>
        <input id="meses" type="number" min="0" max="11" step="1" value="0" required />

        <label for="dias">Días adicionales</label>
        <input id="dias" type="number" min="0" max="29" step="1" value="0" required />

        <label style="display:flex;gap:10px;align-items:center;margin-top:16px">
          <input id="tope" type="checkbox" checked style="width:auto" />
          <span>Aplicar tope de 12 sueldos</span>
        </label>

        <button class="btn gold" type="submit" style="margin-top:18px;width:100%">Calcular indemnización</button>
      </form>
      <div class="warn">
        Aplica a despido arbitrario (contrato indeterminado). No incluye CTS, gratificación ni vacaciones pendientes.
      </div>
    </section>

    <aside class="panel">
      <h2 style="margin-top:0;color:var(--navy)">Tu resultado</h2>
      <div class="result">
        <div style="font-size:.85rem;color:var(--muted)">Indemnización estimada</div>
        <div class="big" id="ind-total">S/ 0.00</div>
        <div class="row"><span>Tiempo reconocido</span><b id="ind-tiempo">1.00 años</b></div>
        <div class="row"><span>Cálculo sin tope</span><b id="ind-sintope">S/ 0.00</b></div>
        <div class="row"><span>Tope legal (12 sueldos)</span><b id="ind-tope">S/ 0.00</b></div>
      </div>
      <p class="hint" style="margin-top:14px">Base legal: 1.5 sueldos por año o fracción, máximo 12 sueldos.</p>
    </aside>
  </div>

  <section class="container explain">
    <div class="panel">
      <h2>¿Cómo se calcula?</h2>
      <p>
        La indemnización por despido arbitrario equivale a <strong>1.5 remuneraciones por cada año completo
        o fracción</strong>, con un máximo de 12 sueldos. Para el tiempo proporcional se suman los meses y días.
      </p>
      <p>
        Fórmula: <strong>1.5 × sueldo × (años + meses/12 + días/360)</strong>, limitado a 12 sueldos.
      </p>
      <h2>Ejemplo</h2>
      <p>
        Sueldo S/ 2,000 y 3 años 6 meses: 1.5 × 2,000 × 3.5 = S/ 10,500. Como no supera el tope de S/ 24,000,
        la indemnización referencial es S/ 10,500.
      </p>
    </div>
    <aside class="panel faq">
      <h2 style="margin-top:0">Preguntas frecuentes</h2>
      {faq.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </aside>
  </section>

  <script is:inline>
    (() => {
      const fmt = (n) => new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN', maximumFractionDigits: 2 }).format(n);
      const num = (id) => Math.max(0, parseFloat(document.getElementById(id).value) || 0);
      document.getElementById('ind-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const sueldo = num('sueldo');
        const anios = Math.floor(num('anios'));
        const meses = Math.min(11, Math.floor(num('meses')));
        const dias = Math.min(29, Math.floor(num('dias')));
        const fraccion = anios + meses / 12 + dias / 360;
        const sinTope = 1.5 * sueldo * fraccion;
        const tope = 12 * sueldo;
        const usarTope = document.getElementById('tope').checked;
        const total = usarTope ? Math.min(sinTope, tope) : sinTope;
        document.getElementById('ind-total').textContent = fmt(total);
        document.getElementById('ind-tiempo').textContent = fraccion.toFixed(2) + ' años';
        document.getElementById('ind-sintope').textContent = fmt(sinTope);
        document.getElementById('ind-tope').textContent = fmt(tope);
      });
    })();
  </script>
</Base>
