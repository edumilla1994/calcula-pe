---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const url = (p = '') => base + p.replace(/^\//, '');

const faq = [
  {
    q: '¿Cuándo se deposita la CTS?',
    a: 'La CTS se deposita dos veces al año: hasta el 15 de mayo (semestre noviembre–abril) y hasta el 15 de noviembre (semestre mayo–octubre).',
  },
  {
    q: '¿Qué incluye la remuneración computable?',
    a: 'Incluye el sueldo básico, la asignación familiar y 1/6 de la última gratificación recibida. No incluye bonos extraordinarios ni utilidades.',
  },
  {
    q: '¿Si trabajé menos de seis meses me corresponde CTS?',
    a: 'Sí. La CTS es proporcional a los meses y días trabajados en el semestre, usando la fórmula remuneración computable / 12 por meses y / 360 por días.',
  },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de CTS Perú 2026',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PEN' },
  inLanguage: 'es-PE',
};
---
<Base
  title="Calculadora de CTS 2026 Perú — Calcula tu depósito"
  description="Calcula tu CTS de mayo o noviembre 2026 con sueldo, asignación familiar y última gratificación. Fórmula oficial explicada y resultado al instante."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <div class="container tool">
    <section class="panel">
      <h1>Calculadora de CTS 2026</h1>
      <p class="sub">Depósito de mayo o noviembre. Ingresa tu sueldo bruto y los meses trabajados en el semestre.</p>
      <form id="cts-form">
        <label for="sueldo">Sueldo bruto mensual (S/)</label>
        <input id="sueldo" type="number" min="0" step="0.01" value="1500" required />

        <label for="asignacion">Asignación familiar (S/)</label>
        <input id="asignacion" type="number" min="0" step="0.01" value="0" />
        <div class="hint">Si no recibes asignación familiar, déjalo en 0.</div>

        <label for="gratificacion">Última gratificación recibida (S/)</label>
        <input id="gratificacion" type="number" min="0" step="0.01" placeholder="Déjalo vacío para usar el sueldo" />
        <div class="hint">Si no sabes, se asume una gratificación igual al sueldo.</div>

        <label for="meses">Meses completos trabajados en el semestre</label>
        <input id="meses" type="number" min="0" max="6" step="1" value="6" required />

        <label for="dias">Días adicionales</label>
        <input id="dias" type="number" min="0" max="30" step="1" value="0" required />

        <button class="btn gold" type="submit" style="margin-top:18px;width:100%">Calcular CTS</button>
      </form>
      <div class="warn">
        Resultado referencial. La CTS se deposita en tu cuenta bancaria y no se descuenta como el sueldo.
      </div>
    </section>

    <aside class="panel">
      <h2 style="margin-top:0;color:var(--navy)">Tu resultado</h2>
      <div class="result" id="cts-result">
        <div style="font-size:.85rem;color:var(--muted)">CTS estimada</div>
        <div class="big" id="cts-total">S/ 0.00</div>
        <div class="row"><span>Remuneración computable</span><b id="cts-rc">S/ 0.00</b></div>
        <div class="row"><span>Meses</span><b id="cts-meses">6</b></div>
        <div class="row"><span>Días</span><b id="cts-dias">0</b></div>
        <div class="row"><span>Fórmula aplicada</span><b style="font-weight:600">RC/12 × meses + RC/360 × días</b></div>
      </div>
      <p class="hint" style="margin-top:14px">
        La remuneración computable incluye sueldo + asignación familiar + 1/6 de la última gratificación.
      </p>
    </aside>
  </div>

  <section class="container explain">
    <div class="panel">
      <h2>¿Cómo se calcula la CTS?</h2>
      <p>
        La Compensación por Tiempo de Servicio (CTS) se calcula con la remuneración computable del mes anterior
        al depósito. La fórmula legal es:
      </p>
      <p><strong>CTS = (Remuneración computable ÷ 12 × meses) + (Remuneración computable ÷ 360 × días)</strong></p>
      <p>
        Para un semestre completo (6 meses) equivale a la mitad de la remuneración computable. Si trabajaste
        menos tiempo, se paga proporcional. La asignación familiar y 1/6 de la última gratificación también
        forman parte de la base.
      </p>
      <h2>Ejemplo rápido</h2>
      <p>
        Sueldo S/ 2,000, sin asignación familiar y con gratificación de S/ 2,000: la remuneración computable es
        S/ 2,333.33 y la CTS de 6 meses es S/ 1,166.67.
      </p>
    </div>
    <aside class="panel faq">
      <h2 style="margin-top:0">Preguntas frecuentes</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </aside>
  </section>

  <script is:inline>
    (() => {
      const fmt = (n) => new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN', maximumFractionDigits: 2 }).format(n);
      const num = (id) => Math.max(0, parseFloat(document.getElementById(id).value) || 0);
      const form = document.getElementById('cts-form');
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const sueldo = num('sueldo');
        const asig = num('asignacion');
        const gratInput = document.getElementById('gratificacion').value;
        const grat = gratInput === '' ? sueldo : Math.max(0, parseFloat(gratInput) || 0);
        const meses = Math.min(6, Math.floor(num('meses')));
        const dias = Math.min(30, Math.floor(num('dias')));
        const rc = sueldo + asig + grat / 6;
        const cts = (rc / 12) * meses + (rc / 360) * dias;
        document.getElementById('cts-total').textContent = fmt(cts);
        document.getElementById('cts-rc').textContent = fmt(rc);
        document.getElementById('cts-meses').textContent = String(meses);
        document.getElementById('cts-dias').textContent = String(dias);
      });
    })();
  </script>
</Base>
