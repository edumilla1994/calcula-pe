---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const url = (p = '') => base + p.replace(/^\//, '');

const faq = [
  { q: '¿Qué es la TEA?', a: 'La Tasa Efectiva Anual es el rendimiento real del préstamo en un año, incluyendo la capitalización. Es distinta de la TNA (tasa nominal).' },
  { q: '¿La cuota calculada es la que me cobrará el banco?', a: 'No necesariamente. Los bancos suelen sumar seguros, portes y comisiones, que se reflejan en la TCEA. Esta calculadora usa solo la TEA.' },
  { q: '¿Qué sistema de amortización usa?', a: 'El sistema francés: cuota fija, con más interés al inicio y más capital al final.' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de préstamo Perú 2026',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PEN' },
  inLanguage: 'es-PE',
};
---
<Base
  title="Calculadora de préstamo 2026 Perú — Cuota mensual y cronograma"
  description="Calcula la cuota mensual, los intereses totales y el cronograma de pagos de un préstamo en Perú usando la TEA. Gratis y al instante."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <div class="container tool">
    <section class="panel">
      <h1>Calculadora de préstamo</h1>
      <p class="sub">Cuota fija (sistema francés) a partir del monto, la TEA y el plazo.</p>
      <form id="prest-form">
        <label for="monto">Monto del préstamo (S/)</label>
        <input id="monto" type="number" min="0" step="0.01" value="10000" required />

        <label for="tea">Tasa Efectiva Anual - TEA (%)</label>
        <input id="tea" type="number" min="0" max="200" step="0.01" value="35" required />
        <div class="hint">Si tu banco te da TNA, conviértela o usa la TCEA de tu cotización.</div>

        <label for="meses">Plazo en meses</label>
        <input id="meses" type="number" min="1" max="120" step="1" value="24" required />

        <button class="btn gold" type="submit" style="margin-top:18px;width:100%">Calcular préstamo</button>
      </form>
      <div class="warn">
        No incluye seguros de desgravamen, portes ni comisiones. La TCEA real suele ser mayor que la TEA.
      </div>
    </section>

    <aside class="panel">
      <h2 style="margin-top:0;color:var(--navy)">Tu resultado</h2>
      <div class="result">
        <div style="font-size:.85rem;color:var(--muted)">Cuota mensual</div>
        <div class="big" id="pres-cuota">S/ 0.00</div>
        <div class="row"><span>Total a pagar</span><b id="pres-total">S/ 0.00</b></div>
        <div class="row"><span>Intereses totales</span><b id="pres-interes">S/ 0.00</b></div>
        <div class="row"><span>Tasa mensual equivalente</span><b id="pres-tem">0.00%</b></div>
      </div>
    </aside>
  </div>

  <section class="container explain">
    <div class="panel">
      <h2>Cronograma de pagos</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Mes</th><th>Cuota</th><th>Interés</th><th>Capital</th><th>Saldo</th></tr>
          </thead>
          <tbody id="pres-tabla">
            <tr><td colspan="5">Ingresa los datos y presiona calcular.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <aside class="panel faq">
      <h2 style="margin-top:0">Preguntas frecuentes</h2>
      {faq.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </aside>
  </section>

  <script is:inline>
    (() => {
      const fmt = (n) => new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN', maximumFractionDigits: 2 }).format(n);
      const num = (id) => Math.max(0, parseFloat(document.getElementById(id).value) || 0);
      document.getElementById('prest-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const monto = num('monto');
        const tea = num('tea') / 100;
        const meses = Math.max(1, Math.floor(num('meses')));
        const i = Math.pow(1 + tea, 1 / 12) - 1;
        const cuota = i === 0 ? monto / meses : (monto * i) / (1 - Math.pow(1 + i, -meses));
        let saldo = monto;
        let interesTotal = 0;
        const filas = [];
        for (let m = 1; m <= meses; m++) {
          const interes = saldo * i;
          const capital = cuota - interes;
          saldo = Math.max(0, saldo - capital);
          interesTotal += interes;
          filas.push('<tr><td>' + m + '</td><td>' + fmt(cuota) + '</td><td>' + fmt(interes) + '</td><td>' + fmt(capital) + '</td><td>' + fmt(saldo) + '</td></tr>');
        }
        document.getElementById('pres-cuota').textContent = fmt(cuota);
        document.getElementById('pres-total').textContent = fmt(cuota * meses);
        document.getElementById('pres-interes').textContent = fmt(interesTotal);
        document.getElementById('pres-tem').textContent = (i * 100).toFixed(4) + '%';
        document.getElementById('pres-tabla').innerHTML = filas.join('');
      });
    })();
  </script>
</Base>
