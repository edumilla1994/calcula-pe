---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const url = (p = '') => base + p.replace(/^\//, '');

const faq = [
  { q: '¿Cuándo se paga la gratificación?', a: 'La gratificación de julio se paga hasta el 15 de julio y la de diciembre hasta el 15 de diciembre.' },
  { q: '¿La bonificación del 9% tiene descuentos?', a: 'No. La bonificación extraordinaria (9% EsSalud o 6.75% EPS) no está afecta a ONP ni AFP; solo la gratificación tiene descuentos.' },
  { q: '¿Si trabajé menos de seis meses me pagan gratificación?', a: 'Sí, de forma proporcional a los meses trabajados en el semestre (máximo seis).' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de gratificación Perú 2026',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PEN' },
  inLanguage: 'es-PE',
};
---
<Base
  title="Calculadora de gratificación 2026 Perú — Julio y diciembre"
  description="Calcula tu gratificación de julio o diciembre 2026 con bonificación del 9% y descuentos de ONP o AFP. Resultado inmediato y fórmula explicada."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <div class="container tool">
    <section class="panel">
      <h1>Calculadora de gratificación 2026</h1>
      <p class="sub">Gratificación de julio o diciembre, con bonificación extraordinaria y descuentos.</p>
      <form id="grat-form">
        <label for="sueldo">Sueldo bruto mensual (S/)</label>
        <input id="sueldo" type="number" min="0" step="0.01" value="1500" required />

        <label for="asignacion">Asignación familiar (S/)</label>
        <input id="asignacion" type="number" min="0" step="0.01" value="0" />

        <label for="meses">Meses trabajados en el semestre</label>
        <input id="meses" type="number" min="1" max="6" step="1" value="6" required />

        <label for="regimen">Régimen de salud</label>
        <select id="regimen">
          <option value="0.09">EsSalud (bonificación 9%)</option>
          <option value="0.0675">EPS (bonificación 6.75%)</option>
        </select>

        <label for="descuento">Descuento de pensión</label>
        <select id="descuento">
          <option value="0.13">ONP (13%)</option>
          <option value="0">Sin descuento</option>
          <option value="0.10">AFP (10% referencial)</option>
        </select>

        <button class="btn gold" type="submit" style="margin-top:18px;width:100%">Calcular gratificación</button>
      </form>
      <div class="warn">La tasa de AFP varía según la comisión de tu administradora; usa el valor de tu boleta para un cálculo exacto.</div>
    </section>

    <aside class="panel">
      <h2 style="margin-top:0;color:var(--navy)">Tu resultado</h2>
      <div class="result">
        <div style="font-size:.85rem;color:var(--muted)">Gratificación neta</div>
        <div class="big" id="grat-neto">S/ 0.00</div>
        <div class="row"><span>Gratificación base</span><b id="grat-base">S/ 0.00</b></div>
        <div class="row"><span>Bonificación extraordinaria</span><b id="grat-bono">S/ 0.00</b></div>
        <div class="row"><span>Total bruto</span><b id="grat-bruto">S/ 0.00</b></div>
        <div class="row"><span>Descuento de pensión</span><b id="grat-desc">S/ 0.00</b></div>
      </div>
      <p class="hint" style="margin-top:14px">La bonificación no se descuenta; el descuento se aplica solo a la gratificación base.</p>
    </aside>
  </div>

  <section class="container explain">
    <div class="panel">
      <h2>¿Cómo se calcula la gratificación?</h2>
      <p>
        La gratificación equivale a una remuneración mensual por cada semestre completo. Si trabajaste menos de
        seis meses, se paga proporcionalmente: <strong>remuneración × meses trabajados ÷ 6</strong>.
      </p>
      <p>
        Además, el empleador paga una <strong>bonificación extraordinaria del 9%</strong> (EsSalud) o
        <strong>6.75%</strong> (EPS) sobre la gratificación. Esa bonificación no tiene descuentos de ONP/AFP.
      </p>
      <h2>Ejemplo</h2>
      <p>
        Sueldo S/ 2,000, seis meses y EsSalud: gratificación S/ 2,000 + bonificación S/ 180 = S/ 2,180 brutos.
        Con ONP (13%) el descuento es S/ 260 y el neto S/ 1,920.
      </p>
    </div>
    <aside class="panel faq">
      <h2 style="margin-top:0">Preguntas frecuentes</h2>
      {faq.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </aside>
  </section>

  <script is:inline>
    (() => {
      const fmt = (n) => new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN', maximumFractionDigits: 2 }).format(n);
      const num = (id) => Math.max(0, parseFloat(document.getElementById(id).value) || 0);
      document.getElementById('grat-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const sueldo = num('sueldo');
        const asig = num('asignacion');
        const meses = Math.min(6, Math.max(0, Math.floor(num('meses'))));
        const tasaBono = parseFloat(document.getElementById('regimen').value);
        const tasaDesc = parseFloat(document.getElementById('descuento').value);
        const base = (sueldo + asig) * (meses / 6);
        const bono = base * tasaBono;
        const bruto = base + bono;
        const desc = base * tasaDesc;
        const neto = bruto - desc;
        document.getElementById('grat-neto').textContent = fmt(neto);
        document.getElementById('grat-base').textContent = fmt(base);
        document.getElementById('grat-bono').textContent = fmt(bono);
        document.getElementById('grat-bruto').textContent = fmt(bruto);
        document.getElementById('grat-desc').textContent = fmt(desc);
      });
    })();
  </script>
</Base>
