---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const url = (p = '') => base + p.replace(/^\//, '');

const faq = [
  {
    q: '¿Qué incluye una liquidación de beneficios sociales?',
    a: 'CTS trunca, gratificación trunca con bonificación extraordinaria, vacaciones truncas y, si el cese es por despido arbitrario, la indemnización. También pueden incluirse bonos pendientes o utilidades.',
  },
  {
    q: '¿La CTS y las vacaciones pagan descuentos?',
    a: 'No. La CTS, las vacaciones y la indemnización están inafectas a descuentos de pensión y renta. La gratificación trunca sí está afecta a ONP o AFP y a renta de quinta categoría.',
  },
  {
    q: '¿Cómo se calculan las vacaciones truncas?',
    a: 'Son proporcionales al tiempo trabajado desde tu último aniversario: 2.5 días por mes completo. Se pagan a razón de un sueldo mensual dividido entre 30 por cada día de vacaciones.',
  },
  {
    q: '¿Cuándo corresponde indemnización?',
    a: 'Solo en casos de despido arbitrario o improcedente. La fórmula es 1.5 remuneraciones por cada año de servicio, con un tope de 12 remuneraciones. No aplica en renuncia voluntaria ni en cese por mutuo acuerdo.',
  },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de liquidación de beneficios sociales Perú 2026',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PEN' },
  inLanguage: 'es-PE',
};
---

<Base
  title="Liquidación de beneficios sociales 2026 — CTS, gratificación y vacaciones"
  description="Calcula tu liquidación por cese en Perú 2026: CTS trunca, gratificación trunca con bono 9%, vacaciones truncas e indemnización. Resultado al instante."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <div class="container tool">
    <section class="panel">
      <h1>Liquidación de beneficios sociales 2026</h1>
      <p class="sub">Para cuando termina la relación laboral. Calcula CTS, gratificación y vacaciones truncas.</p>
      <form id="liq-form">
        <label for="sueldo">Sueldo bruto mensual (S/)</label>
        <input id="sueldo" type="number" min="0" step="0.01" value="2000" required />

        <label for="asignacion">Asignación familiar (S/)</label>
        <input id="asignacion" type="number" min="0" step="0.01" value="0" />

        <label for="gratificacion">Última gratificación recibida (S/)</label>
        <input id="gratificacion" type="number" min="0" step="0.01" placeholder="Déjalo vacío para usar el sueldo" />
        <div class="hint">Se usa para calcular la remuneración computable de la CTS trunca.</div>

        <label for="ingreso">Fecha de ingreso</label>
        <input id="ingreso" type="date" value="2026-01-01" required />

        <label for="cese">Fecha de cese</label>
        <input id="cese" type="date" value="2026-06-30" required />

        <label for="salud">Régimen de salud</label>
        <select id="salud">
          <option value="0.09">EsSalud (bono 9%)</option>
          <option value="0.0675">EPS (bono 6.75%)</option>
        </select>

        <label for="descuento">Descuento de pensión (solo gratificación)</label>
        <select id="descuento">
          <option value="0.13">ONP (13%)</option>
          <option value="0">Sin descuento</option>
          <option value="0.10">AFP (10% referencial)</option>
        </select>

        <label for="indemnizacion">¿Incluir indemnización?</label>
        <select id="indemnizacion">
          <option value="0">No, solo beneficios sociales</option>
          <option value="1">Sí, despido arbitrario (1.5 sueldos por año)</option>
        </select>

        <button class="btn gold" type="submit" style="margin-top:18px;width:100%">Calcular liquidación</button>
      </form>
      <div class="warn">
        Resultado referencial. No reemplaza la liquidación oficial del empleador ni una consulta laboral.
        No incluye renta de quinta, bonos pendientes ni utilidades.
      </div>
    </section>

    <aside class="panel">
      <h2 style="margin-top:0;color:var(--navy)">Tu liquidación</h2>
      <div class="result">
        <div style="font-size:.85rem;color:var(--muted)">Total a recibir (estimado)</div>
        <div class="big" id="liq-total">S/ 0.00</div>
        <div class="row"><span>Tiempo de servicio</span><b id="liq-tiempo">—</b></div>
        <div class="row"><span>CTS trunca</span><b id="liq-cts">S/ 0.00</b></div>
        <div class="row"><span>Gratificación trunca</span><b id="liq-grat">S/ 0.00</b></div>
        <div class="row"><span>Bono extraordinario</span><b id="liq-bono">S/ 0.00</b></div>
        <div class="row"><span>Vacaciones truncas</span><b id="liq-vac">S/ 0.00</b></div>
        <div class="row"><span>Indemnización</span><b id="liq-indem">S/ 0.00</b></div>
        <div class="row"><span>Descuento de pensión</span><b id="liq-desc">S/ 0.00</b></div>
      </div>
      <p class="hint" style="margin-top:14px">
        El descuento de pensión se aplica solo a la gratificación trunca. CTS, vacaciones e indemnización están
        inafectas.
      </p>
    </aside>
  </div>

  <section class="container explain">
    <div class="panel">
      <h2>¿Cómo se calcula cada beneficio?</h2>
      <ul>
        <li>
          <strong>CTS trunca:</strong> remuneración computable ÷ 12 × meses + remuneración computable ÷ 360 × días
          del semestre en curso (mayo–octubre o noviembre–abril).
        </li>
        <li>
          <strong>Gratificación trunca:</strong> remuneración × meses trabajados ÷ 6, más la bonificación
          extraordinaria del 9% (EsSalud) o 6.75% (EPS).
        </li>
        <li>
          <strong>Vacaciones truncas:</strong> 2.5 días por mes completo desde tu último aniversario, pagados a
          razón de sueldo ÷ 30 por día.
        </li>
        <li>
          <strong>Indemnización:</strong> 1.5 remuneraciones por año de servicio, con tope de 12 remuneraciones.
          Solo si el despido es arbitrario.
        </li>
      </ul>
      <p>
        La <strong>remuneración computable</strong> de la CTS incluye el sueldo, la asignación familiar y 1/6 de la
        última gratificación. La gratificación trunca y las vacaciones se calculan sobre el sueldo más la
        asignación familiar.
      </p>
      <h2>Ejemplo</h2>
      <p>
        Ingreso el 1 de enero de 2026 y cese el 30 de junio de 2026, con sueldo de S/ 2,000 y gratificación de
        S/ 2,000: CTS trunca S/ 388.89, gratificación S/ 2,000 + bono S/ 180, vacaciones S/ 1,000. Total bruto
        S/ 3,568.89.
      </p>
    </div>
    <aside class="panel faq">
      <h2 style="margin-top:0">Preguntas frecuentes</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </aside>
  </section>

  <script is:inline>
    (() => {
      const fmt = (n) => new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN', maximumFractionDigits: 2 }).format(n);
      const num = (id) => Math.max(0, parseFloat(document.getElementById(id).value) || 0);
      const DAY = 86400000;
      const utc = (str) => {
        if (!str) return null;
        const [y, m, d] = str.split('-').map(Number);
        return new Date(Date.UTC(y, m - 1, d));
      };
      const addMonths = (date, n) => new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + n, date.getUTCDate()));
      const mesesCalendario = (inicio, fin) => {
        let m = (fin.getUTCFullYear() - inicio.getUTCFullYear()) * 12 + (fin.getUTCMonth() - inicio.getUTCMonth());
        if (fin.getUTCDate() >= inicio.getUTCDate() - 1) m += 1;
        if (m < 0) m = 0;
        const cursor = addMonths(inicio, m);
        const dias = Math.max(0, Math.round((fin - cursor) / DAY));
        return { meses: m, dias };
      };
      const diffYMD = (inicio, fin) => {
        let anios = fin.getUTCFullYear() - inicio.getUTCFullYear();
        let meses = fin.getUTCMonth() - inicio.getUTCMonth();
        let dias = fin.getUTCDate() - inicio.getUTCDate();
        if (dias < 0) {
          meses -= 1;
          const prev = new Date(Date.UTC(fin.getUTCFullYear(), fin.getUTCMonth(), 0));
          dias += prev.getUTCDate();
        }
        if (meses < 0) {
          anios -= 1;
          meses += 12;
        }
        return { anios: Math.max(0, anios), meses: Math.max(0, meses), dias: Math.max(0, dias) };
      };

      document.getElementById('liq-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const sueldo = num('sueldo');
        const asig = num('asignacion');
        const gratInput = document.getElementById('gratificacion').value;
        const gratUltima = gratInput === '' ? sueldo : Math.max(0, parseFloat(gratInput) || 0);
        const ingreso = utc(document.getElementById('ingreso').value);
        const cese = utc(document.getElementById('cese').value);
        const tasaBono = parseFloat(document.getElementById('salud').value);
        const tasaDesc = parseFloat(document.getElementById('descuento').value);
        const conIndem = document.getElementById('indemnizacion').value === '1';

        if (!ingreso || !cese || cese < ingreso) {
          document.getElementById('liq-total').textContent = 'Revisa las fechas';
          return;
        }

        const base = sueldo + asig;
        const rc = base + gratUltima / 6;
        const tiempo = diffYMD(ingreso, cese);

        // CTS trunca: semestre en curso (mayo-octubre o noviembre-abril)
        const mesCese = cese.getUTCMonth() + 1;
        let inicioCts;
        if (mesCese >= 5 && mesCese <= 10) {
          inicioCts = new Date(Date.UTC(cese.getUTCFullYear(), 4, 1));
        } else if (mesCese >= 11) {
          inicioCts = new Date(Date.UTC(cese.getUTCFullYear(), 10, 1));
        } else {
          inicioCts = new Date(Date.UTC(cese.getUTCFullYear() - 1, 10, 1));
        }
        const periodoCts = mesesCalendario(inicioCts, cese);
        const cts = (rc / 12) * periodoCts.meses + (rc / 360) * periodoCts.dias;

        // Gratificación trunca: semestre enero-junio o julio-diciembre
        const inicioGrat = mesCese <= 6
          ? new Date(Date.UTC(cese.getUTCFullYear(), 0, 1))
          : new Date(Date.UTC(cese.getUTCFullYear(), 6, 1));
        const periodoGrat = mesesCalendario(inicioGrat, cese);
        const grat = (base / 6) * periodoGrat.meses + (base / 180) * periodoGrat.dias;
        const bono = grat * tasaBono;

        // Vacaciones truncas: desde el último aniversario de ingreso
        const anioAniv = cese.getUTCFullYear();
        let aniversario = new Date(Date.UTC(anioAniv, ingreso.getUTCMonth(), ingreso.getUTCDate()));
        if (aniversario > cese) {
          aniversario = new Date(Date.UTC(anioAniv - 1, ingreso.getUTCMonth(), ingreso.getUTCDate()));
        }
        const periodoVac = mesesCalendario(aniversario, cese);
        const vac = (base / 12) * periodoVac.meses + (base / 360) * periodoVac.dias;

        // Indemnización por despido arbitrario
        const aniosServicio = tiempo.anios + tiempo.meses / 12 + tiempo.dias / 360;
        const indem = conIndem ? Math.min(1.5 * base * aniosServicio, 12 * base) : 0;

        const bruto = cts + grat + bono + vac + indem;
        const desc = grat * tasaDesc;
        const total = bruto - desc;

        document.getElementById('liq-total').textContent = fmt(total);
        document.getElementById('liq-tiempo').textContent = `${tiempo.anios}a ${tiempo.meses}m ${tiempo.dias}d`;
        document.getElementById('liq-cts').textContent = fmt(cts);
        document.getElementById('liq-grat').textContent = fmt(grat);
        document.getElementById('liq-bono').textContent = fmt(bono);
        document.getElementById('liq-vac').textContent = fmt(vac);
        document.getElementById('liq-indem').textContent = fmt(indem);
        document.getElementById('liq-desc').textContent = fmt(desc);
      });
    })();
  </script>
</Base>
